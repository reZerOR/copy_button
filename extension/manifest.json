{
  "manifest_version": 3,
  "name": "Button Copy",
  "version": "1.0.0",
  "description": "Choose website buttons, save their styling and states locally, and export reusable code.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Button Copy" },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'self'"
  }
}
