    {
      "name": "Capture card",
      "kind": "card",
      "refersTo": "capture-card",
      "description": "Preview container with independent selection and detail-opening controls. The example leaves the source preview empty.",
      "html": "<article class=\"ds-card\"><div class=\"ds-preview\"><label class=\"ds-card-select\"><input type=\"checkbox\" aria-label=\"Select saved button\"></label></div><button class=\"ds-card-info\"><span class=\"ds-title\">Saved button</span><span class=\"ds-domain\">example.com</span><span class=\"ds-card-bottom\"><span class=\"ds-state-pill\">3 states</span><span>Capture notes</span></span></button></article>",
      "css": ".ds-card{font:14px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;border:1px solid var(--border,#2e3c32);border-radius:var(--radius,12px);overflow:hidden;background:var(--surface,#141b16);min-width:0;width:260px;color:var(--ink,#eef4ef)}.ds-preview{height:182px;background:#19221c;position:relative;display:flex;align-items:center;justify-content:center}.ds-card-select{position:absolute;top:12px;left:12px;display:flex;padding:4px;background:#111a14;border:1px solid #3d5043;border-radius:5px}.ds-card-select input{margin:0;width:16px;height:16px;accent-color:#11633d;cursor:pointer}.ds-card-info{display:block;background:transparent;width:100%;text-align:left;padding:15px 17px 16px;border:0;color:inherit;cursor:pointer;font:550 14px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;transition:background .16s ease-out}.ds-card-info:hover{background:#1b2a20}.ds-card-info:focus-visible,.ds-card-select input:focus-visible{outline:2px solid var(--focus,#8bc7a5);outline-offset:3px;}.ds-title{display:block;font-size:14px;font-weight:600;white-space:nowrap;text-overflow:ellipsis;overflow:hidden;margin-bottom:5px}.ds-domain{font-size:12px;color:var(--muted,#acbeb0);display:block;white-space:nowrap;text-overflow:ellipsis;overflow:hidden}.ds-card-bottom{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:14px;font-size:12px;color:var(--muted,#acbeb0)}.ds-state-pill{display:inline-block;font-size:12px;padding:3px 7px;background:#24372b;border-radius:4px;color:#bfdac8}.ds-card:has(input:checked){border-color:#91bda3}@media(prefers-reduced-motion:reduce){.ds-card-info{transition:none}}"
