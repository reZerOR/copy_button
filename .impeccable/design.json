      "css": ".ds-secondary{font:550 14px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:inline-flex;gap:9px;align-items:center;justify-content:center;cursor:pointer;border-radius:7px;padding:11px 17px;min-height:42px;transition:background .16s ease-out;text-align:left;border:1px solid var(--border,#2e3c32);background:var(--surface-2,#1b251e);color:var(--ink,#eef4ef)}.ds-secondary:hover:not(:disabled){background:#27372b}.ds-secondary:focus-visible{outline:2px solid var(--focus,#8bc7a5);outline-offset:3px;}.ds-secondary:disabled{opacity:.45;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-secondary{transition:none}}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "search",
      "description": "One outlined container around the search icon and text field.",
      "html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><circle cx=\"10\" cy=\"10\" r=\"6\"/><path d=\"m15 15 6 6\"/></svg><input type=\"search\" aria-label=\"Search saved buttons\" placeholder=\"Search by name or website\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:10px;background:var(--surface,#141b16);border:1px solid var(--border,#2e3c32);border-radius:7px;padding:9px 13px;max-width:460px;color:var(--muted,#acbeb0)}.ds-search svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}.ds-search input{font:13px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;border:0;outline:none;background:transparent;width:100%;color:var(--ink,#eef4ef);caret-color:var(--focus,#8bc7a5)}.ds-search input::placeholder{color:var(--muted,#acbeb0);opacity:1}.ds-search:focus-within{outline:2px solid var(--focus,#8bc7a5);outline-offset:3px;}"
    },
    {
      "name": "Collection navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Selected collection filter with a right-aligned count.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Library filters\"><button class=\"ds-nav-item ds-selected\" aria-pressed=\"true\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>All buttons<span class=\"ds-count\">0</span></button><button class=\"ds-nav-item\" aria-pressed=\"false\">Capture notes<span class=\"ds-count\">0</span></button></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:6px;width:184px}.ds-nav-item{font:550 13px/1.5 system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;display:flex;align-items:center;gap:10px;width:100%;padding:11px 12px;border:0;border-radius:7px;text-align:left;background:transparent;color:var(--muted,#acbeb0);cursor:pointer;transition:background .16s ease-out}.ds-nav-item svg{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.65;flex-shrink:0}.ds-count{margin-left:auto;font-size:12px;color:#c4d7ca;background:#26362b;border-radius:5px;padding:2px 7px;font-variant-numeric:tabular-nums}.ds-nav-item.ds-selected{background:var(--forest,#004225);color:#edf7f0}.ds-selected .ds-count{background:#1d6140;color:#f0faf4}.ds-nav-item:hover:not(.ds-selected){background:var(--surface-2,#1b251e);color:var(--ink,#eef4ef)}.ds-nav-item:focus-visible{outline:2px solid var(--focus,#8bc7a5);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-nav-item{transition:none}}"
    },
